                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Typed enrollment error. After uncertain creation reconcile the same request ID; do not mint a replacement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Typed enrollment error. After uncertain creation reconcile the same request ID; do not mint a replacement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Typed enrollment error. After uncertain creation reconcile the same request ID; do not mint a replacement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Requires eab:create. Reference/target must match host grants. Same key/body replays return metadata only; changed body conflicts. Only the committing request may receive the HMAC, and delivery cannot be proven by HTTP success. A different request ID cannot replace an unresolved unused key for the same owned target/reference: existing_entry requires explicit invalidation first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          }
        }
      }
    },
