      "post": {
        "operationId": "danceEnrollmentCreate",
        "summary": "Create one enrollment credential over HTTPS",
        "security": [
          {
            "apiAdminToken": []
          },
          {
            "machine": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata only; no HMAC",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrollment"
                }
              }
            }
          },
          "201": {
            "description": "One-time sensitive response. Cache-Control: no-store. The authorised client handles secret storage and consumer delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "400": {
            "description": "Typed enrollment error. After uncertain creation reconcile the same request ID; do not mint a replacement.",
