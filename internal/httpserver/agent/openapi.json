  "components": {
    "securitySchemes": {
      "machine": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional scoped, expiring and revocable bearer issued by dance admin. Restricted to granted operations/provisioners and principal-owned target/reference records."
      },
      "apiAdminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator-configured DANCE_API_ADMIN_TOKEN or DANCE_API_ADMIN_TOKEN_FILE. Enrollment administration across configured provisioners, including existing human-created keys. Independent of browser/session/CA credentials."
      }
    },
    "schemas": {
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request_id",
          "provisioner_id",
          "provisioner",
          "directory",
          "reference",
          "target",
          "created_at",
          "state",
          "delivery"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "provisioner_id": {
            "type": "string"
          },
          "provisioner": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "bound_at": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "unused",
              "bound",
              "invalidated"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": [
              "not_attempted",
              "credential_unavailable"
            ]
          }
        }
      },
      "Created": {
        "allOf": [
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "request_id",
              "provisioner_id",
              "provisioner",
              "directory",
              "reference",
              "target",
              "created_at",
              "state",
              "delivery"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "provisioner_id": {
                "type": "string"
              },
              "provisioner": {
                "type": "string"
              },
              "directory": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "bound_at": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "unused",
                  "bound",
                  "invalidated"
                ]
              },
              "delivery": {
                "type": "string",
                "enum": [
                  "not_attempted",
                  "credential_unavailable"
                ]
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "hmac": {
                "type": "string",
                "description": "One-time base64url HMAC returned to the authorised HTTPS client. Protect this response; do not disclose it in chat, logs or configuration dumps.",
                "minLength": 43,
                "maxLength": 43
              }
            },
            "required": [
              "hmac"
            ]
          }
        ]
      },
      "CreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "target"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "Provisioner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "require_eab": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "version",
          "error"
        ],
        "properties": {
          "version": {
            "const": "v1"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated",
                  "scope_denied",
                  "not_found",
                  "invalid_request",
                  "idempotency_conflict",
                  "already_bound",
                  "rate_limited",
                  "backend_unavailable",
                  "unsupported_backend",
                  "delivery_unknown",
                  "existing_entry"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
