{
  "openapi": "3.1.0",
  "info": {
    "title": "Dance agent enrollment API",
    "version": "1.0.0",
    "description": "HTTPS enrollment management using an API admin bearer token or restricted machine credential. Requires an embedded Badger CA. Responses use Cache-Control: no-store. Target/reference are inventory labels. Only the initial creation response contains the one-time HMAC; clients must protect and deliver that credential to their ACME consumer."
  },
